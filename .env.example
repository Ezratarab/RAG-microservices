# Copy to .env and fill in real values. .env is git-ignored: never commit real secrets.

# Oracle admin (SYS/SYSTEM)
ORACLE_PASSWORD=change-me
# One DB user per service, created on first start by infra/oracle/init/01-create-users.sh
KEYCLOAK_DB_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me
BILLING_DB_PASSWORD=change-me

# Keycloak admin console login
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Keycloak client "saas-auth": Clients > saas-auth > Credentials (secret) and the id in the URL (uuid)
KEYCLOAK_CLIENT_SECRET=paste-from-keycloak
KEYCLOAK_CLIENT_UUID=paste-from-keycloak

# Redis (vector store + gateway rate limits)
REDIS_PASSWORD=change-me
